<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Storage Icon"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#0052FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Storage Cleaner AI"
            android:textColor="#191C1E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_txt_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="84% Used"
            android:textColor="#0052FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="84"
        android:progressDrawable="@android:drawable/progress_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_txt_free_space"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="18.5 GB Free of 128 GB"
            android:textColor="#43474E"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#0052FF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⚡ One-Tap Scan"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
