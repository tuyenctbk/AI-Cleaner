<string name="onboarding_skip">לדלג</string><string name="onboarding_next">הבא</string><string name="onboarding_get_started">להתחיל</string><string name="onboarding_title_1">מנקה אחסון מבוסס AI</string><string name="onboarding_desc_1">סריקה אוטומטית של Gemini AI, ניקוי קבצים מיותרים ואופטימיזציה של המטמון בבלחיצה אחת.</string><string name="onboarding_title_2">ניקוי גלריה בהחלקה</string><string name="onboarding_desc_2">החלק שמאלה כדי למחוק תמונות מיותרות והחלק ימינה כדי לשמור את הזכרונות היפים.</string><string name="onboarding_title_3">כספת חכמה ותפוגה</string><string name="onboarding_desc_3">מיון אוטומטי של קבצים לכספת מאובטחת והגדרת כללי תפוגה להורדות.</string><string name="rate_title">נהנים מ-מנקה אחסון AI?</string><string name="rate_desc">המשוב שלכם עוזר לנו להפוך את ניקוי המכשיר למהיר וחכם יותר!</string><string name="rate_btn_submit">דרגו 5 כוכבים ב-Play Store</string><string name="rate_btn_later">הזכר לי מאוחר יותר</string><string name="rate_btn_no">לא תודה</string><string name="rate_success_toast">תודה רבה על דירוג 5 הכוכבים!</string><string name="share_title">שתפו את חיסכון המקום עם חברים!</string><string name="share_desc">עזרו לחברים לשחרר גיגה-בייטים של אחסון בטלפונים שלהם.</string><string name="share_btn_share">שיתוף האפליקציה באמצעות...</string><string name="share_btn_copy">העתקת קישור שיתוף</string><string name="share_btn_later">אולי מאוחר יותר</string><string name="share_text_template">נסו את מנקה אחסון AI! עכשיו חסכתי גיגה-בייטים רבים בטלפון שלי.</string><string name="share_link_copied">קישור השיתוף הועתק ללוח!</string><string name="settings_rate_app">דירוג האפליקציה ב-Play Store</string><string name="settings_share_app">שיתוף האפליקציה עם חברים</string><string name="settings_view_onboarding">צפייה במדריך</string><string name="settings_about_header">משוב ושיתוף האפליקציה</string></resources>