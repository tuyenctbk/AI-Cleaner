    <string name="perm_rationale_title">Before We Begin</string>
    <string name="perm_rationale_subtitle">AI Cleaner needs a few permissions to scan your storage and keep you informed. Here is exactly what each permission does and why it\'s needed.</string>
    <string name="perm_photos_title">📷 Access Photos &amp; Images</string>
    <string name="perm_photos_why">Why: To scan your gallery for duplicate, blurry, and cloud-backed photos that can be safely deleted to free up space.</string>
    <string name="perm_photos_what_not">What we will NOT do: Read the content of your photos, upload them, or share them with anyone.</string>
    <string name="perm_videos_title">🎬 Access Videos</string>
    <string name="perm_videos_why">Why: To find large video files and offer compression so you keep your memories at a fraction of the storage cost.</string>
    <string name="perm_videos_what_not">What we will NOT do: Modify, upload, or share your videos. We only read file sizes and names.</string>
    <string name="perm_notifications_title">🔔 Send Notifications (Optional)</string>
    <string name="perm_notifications_why">Why: To alert you when your storage drops critically low, so you can free space before running out.</string>
    <string name="perm_notifications_what_not">What we will NOT do: Spam you. We send at most one alert per day and only when storage is genuinely low.</string>
    <string name="perm_rationale_privacy_note">🔒 Your privacy is our priority. All analysis happens entirely on your device. No files are ever uploaded to any server.</string>
    <string name="perm_rationale_grant_btn">Grant Access &amp; Continue</string>
