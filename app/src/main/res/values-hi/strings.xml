<string name="onboarding_skip">छोड़ें</string><string name="onboarding_next">आगे</string><string name="onboarding_get_started">शुरू करें</string><string name="onboarding_title_1">AI स्टोरेज क्लीनर</string><string name="onboarding_desc_1">Gemini AI स्कैनिंग, अनावश्यक फ़ाइलों की सफाई और सिस्टम कैश ऑप्टिमाइजेशन एक टैप में।</string><string name="onboarding_title_2">स्वाइप गैलरी क्लीनर</string><string name="onboarding_desc_2">अवांछित फ़ोटो हटाने के लिए बाएं स्वाइप करें और अच्छी फ़ोटो रखने के लिए दाएं स्वाइप करें।</string><string name="onboarding_title_3">स्मार्ट वॉल्ट और एक्सपायरी</string><string name="onboarding_desc_3">फ़ाइलों को सुरक्षित वॉल्ट में ऑटो-सॉर्ट करें और डाउनलोड के लिए एक्सपायरी नियम सेट करें।</string><string name="rate_title">क्या आपको AI स्टोरेज क्लीनर पसंद आ रहा है?</string><string name="rate_desc">आपकी प्रतिक्रिया हमें ऐप को और बेहतर और तेज़ बनाने में मदद करती है!</string><string name="rate_btn_submit">प्ले स्टोर पर 5 स्टार रेटिंग दें</string><string name="rate_btn_later">बाद में याद दिलाएं</string><string name="rate_btn_no">जी नहीं</string><string name="rate_success_toast">5 स्टार रेटिंग देने के लिए धन्यवाद!</string><string name="share_title">दोस्तों के साथ स्टोरेज की बचत शेयर करें!</string><string name="share_desc">अपने दोस्तों को उनके फोन में जीबी स्टोरेज खाली करने में मदद करें।</string><string name="share_btn_share">ऐप शेयर करें...</string><string name="share_btn_copy">शेयर लिंक कॉपी करें</string><string name="share_btn_later">शायद बाद में</string><string name="share_text_template">AI स्टोरेज क्लीनर देखें! मैंने अभी AI फोटो क्लीनिंग से अपने फोन में GB स्टोरेज बचाई है।</string><string name="share_link_copied">ऐप शेयर लिंक क्लिपबोर्ड पर कॉपी हो गया!</string><string name="settings_rate_app">प्ले स्टोर पर रेटिंग दें</string><string name="settings_share_app">दोस्तों के साथ शेयर करें</string><string name="settings_view_onboarding">ट्यूटोरियल देखें</string><string name="settings_about_header">फीडबैक और शेयरिंग</string></resources>