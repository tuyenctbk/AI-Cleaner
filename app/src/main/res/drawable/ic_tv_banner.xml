<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Deep-Space Gradient Background -->
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A0A30" />
                <item android:offset="0.5" android:color="#241147" />
                <item android:offset="1.0" android:color="#0A1C3E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Purple Ambient Wave (Center Right) -->
    <path android:pathData="M 230,90 m -60,0 a 60,60 0 1,1 120,0 a 60,60 0 1,1 -120,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="230"
                android:centerY="90"
                android:gradientRadius="60"
                android:type="radial">
                <item android:offset="0.0" android:color="#506750A4" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Cyan Ambient Wave (Center Left) -->
    <path android:pathData="M 80,90 m -50,0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="80"
                android:centerY="90"
                android:gradientRadius="50"
                android:type="radial">
                <item android:offset="0.0" android:color="#4000FFF0" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Abstract Tech Matrix Background Lines -->
    <path
        android:pathData="M 0,30 L 320,30 M 0,150 L 320,150 M 40,0 L 40,180 M 280,0 L 280,180"
        android:strokeWidth="0.5"
        android:strokeColor="#10FFFFFF" />

    <!-- Holographic Energy Sweeping Ring around Left Phone -->
    <path
        android:pathData="M 80,38 A 52,52 0 1,1 28,90"
        android:strokeWidth="2"
        android:strokeColor="#40FFFFFF"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 28,90 A 52,52 0 0,1 80,38"
        android:strokeWidth="3.5"
        android:strokeColor="#FF00FFF0"
        android:strokeLineCap="round" />

    <!-- Central Left Phone Frame -->
    <path
        android:pathData="M 54,40 h 52 a 8,8 0 0,1 8,8 v 84 a 8,8 0 0,1 -8,8 H 54 a 8,8 0 0,1 -8,-8 V 48 a 8,8 0 0,1 8,-8 Z"
        android:fillColor="#30000000"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF" />

    <!-- Inner Phone Screen Graphics -->
    <path
        android:pathData="M 49,50 h 62"
        android:strokeWidth="1"
        android:strokeColor="#30FFFFFF" />

    <path
        android:pathData="M 76,44 h 8"
        android:strokeWidth="2"
        android:strokeColor="#40FFFFFF"
        android:strokeLineCap="round" />

    <!-- Progress Donut inside Phone Screen -->
    <path
        android:pathData="M 80,92 m -20,0 a 20,20 0 1,1 40,0 a 20,20 0 1,1 -40,0"
        android:strokeWidth="3"
        android:strokeColor="#30FFFFFF" />

    <path
        android:pathData="M 80,72 A 20,20 0 0,1 100,92"
        android:strokeWidth="4"
        android:strokeColor="#FF00FFF0"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 80,92 L 94,92"
        android:strokeWidth="1.5"
        android:strokeColor="#FF00FFF0" />

    <!-- Phone Inner Bar indicators -->
    <path
        android:pathData="M 60,124 h 16"
        android:strokeWidth="4"
        android:strokeColor="#80FFFFFF"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 60,130 h 24"
        android:strokeWidth="4"
        android:strokeColor="#FF00FFF0"
        android:strokeLineCap="round" />

    <!-- Floating File Crystals/Diamonds (Middle Column) -->
    <!-- Crystal 1 -->
    <path
        android:pathData="M 152,48 L 160,56 L 152,64 L 144,56 Z"
        android:fillColor="#80D0BCFF"
        android:strokeWidth="1"
        android:strokeColor="#D0BCFF" />

    <!-- Crystal 2 (Targeted / Compressing) -->
    <path
        android:pathData="M 176,104 L 188,116 L 176,128 L 164,116 Z"
        android:fillColor="#8000FFF0"
        android:strokeWidth="1"
        android:strokeColor="#00FFF0" />

    <!-- Connection Beam/Laser Lines from phone to Crystals -->
    <path
        android:pathData="M 114,80 L 144,56 M 114,104 L 164,116"
        android:strokeWidth="1.5"
        android:strokeColor="#4000FFF0"
        android:strokeLineCap="round" />

    <!-- Majestic AI Glowing Star (Right Side Centerpiece) -->
    <path
        android:pathData="M 234,44 Q 234,84 274,84 Q 234,84 234,124 Q 234,84 194,84 Q 234,84 234,44 Z"
        android:fillColor="#FFD700" />

    <!-- Outer Gold Ring for AI Star -->
    <path
        android:pathData="M 234,84 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0"
        android:strokeWidth="1.5"
        android:strokeColor="#40FFD700" />

    <!-- Sparkling Accent Star 1 (Cyan) -->
    <path
        android:pathData="M 184,34 Q 184,39 189,39 Q 184,39 184,44 Q 184,39 179,39 Q 184,39 184,34 Z"
        android:fillColor="#FF00FFF0" />

    <!-- Sparkling Accent Star 2 (Cyan) -->
    <path
        android:pathData="M 284,124 Q 284,129 289,129 Q 284,129 284,134 Q 284,129 279,129 Q 284,129 284,124 Z"
        android:fillColor="#FF00FFF0" />

    <!-- Sparkling Accent Star 3 (Gold) -->
    <path
        android:pathData="M 288,44 Q 288,48 292,48 Q 288,48 288,52 Q 288,48 284,48 Q 288,48 288,44 Z"
        android:fillColor="#FFD700" />

</vector>
