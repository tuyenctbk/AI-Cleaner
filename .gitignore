# =========================================================================
# Android & Gradle .gitignore
# =========================================================================

# Built application files & outputs
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
/build/
**/build/
/captures/

# Gradle
.gradle/
buildOutputCleanup/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin & KSP
.kotlin/
*.kotlin_module
kspCaches/

# Android Studio / IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/
!.idea/codeStyles/
!.idea/misc.xml
!.idea/vcs.xml
out/

# Android NDK / CMake / C++
.externalNativeBuild/
.cxx/

# Secrets & Sensitive Credentials
# (Contains signing keys, passwords, API secrets, private keystores)
local.properties
*.local.properties
common_release_key.jks
*.jks
*.keystore
*.p12
*.key
*.pem
*.pepk
debug.keystore
secrets.properties
.env
.env.*
!.env.example
local.defaults.properties

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Memory Dumps & Diagnostics
*.hprof
*.log

# VS Code & other editors
.vscode/
*.swp
*~
*.bak
