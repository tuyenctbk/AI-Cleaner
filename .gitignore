# =========================================================================
# Android & Gradle .gitignore
# =========================================================================

# Built application files & bundle outputs
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
*.apks
*.idsig
/build/
**/build/
/captures/
release/
bundle/

# Gradle
.gradle/
buildOutputCleanup/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin & KSP
.kotlin/
*.kotlin_module
kspCaches/

# Android Studio / IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/
!.idea/codeStyles/
!.idea/misc.xml
!.idea/vcs.xml
out/

# Android NDK / CMake / C++
.externalNativeBuild/
.cxx/

# Secrets & Sensitive Credentials
# (Contains signing keys, passwords, API secrets, private keystores)
local.properties
*.local.properties
common_release_key.jks
*.jks
*.keystore
*.p12
*.key
*.pem
*.pepk
debug.keystore
secrets.properties
.env
.env.*
!.env.example
local.defaults.properties

# Python & Scripting Tools
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/

# Testing & Roborazzi outputs
**/roborazzi/
**/recordings/
**/screenshots/

# CI / Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Memory Dumps & Diagnostics
*.hprof
*.log

# Editors & Tools
.vscode/
.fleet/
*.swp
*~
*.bak
*.orig
*.rej
